---
import CartePage from '../components/react/CartePage';
import SEO from '../components/SEO.astro';
import Layout from '../layouts/Layout.astro';

export const prerender = true;
---

<Layout
  title="La Carte"
  description="Découvrez notre carte de pains artisanaux au levain : baguettes de tradition, pains spéciaux, brioches, viennoiseries et gourmandises. Tous fabriqués à la demande avec des farines bio."
  canonical="/carte"
  ogImage="/og/carte.png"
>
  <SEO
    page="carte"
    breadcrumbs={[
      { name: 'Accueil', url: '/' },
      { name: 'La Carte', url: '/carte' },
    ]}
  />
  <CartePage client:load />
</Layout>
