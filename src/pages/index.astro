---
import Layout from '../layouts/Layout.astro';
import SEO from '../components/SEO.astro';
import HomePage from '../components/react/HomePage';
import { getEntry } from 'astro:content';
import { marked } from 'marked';

export const prerender = true;

const page = await getEntry('pages', 'home');
const { title, tagline, intro } = page?.data || {};
const introHtml = intro ? await marked.parse(intro) : '';
---

<Layout
  title="Accueil"
  description="Boulangerie artisanale bio à Suresnes. Pains au levain naturel, livraison à domicile, commande personnalisée. Tout est fait main avec des farines bio locales et semences paysannes."
  canonical="/"
>
  <SEO
    page="home"
    breadcrumbs={[
      { name: 'Accueil', url: '/' },
    ]}
  />
  <HomePage client:load title={title} tagline={tagline} introHtml={introHtml} />
</Layout>
