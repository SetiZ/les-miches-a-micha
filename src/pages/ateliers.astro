---
import { getEntry } from 'astro:content';
import AteliersPage from '../components/react/Ateliers';
import SEO from '../components/SEO.astro';
import Layout from '../layouts/Layout.astro';

export const prerender = true;

const page = await getEntry('pages', 'ateliers');
const {
  title,
  subtitle,
  intro,
  workshops,
  formats,
  contactPhone,
  contactEmail,
  outro,
} = page?.data || {};
---

<Layout
  title="Ateliers Boulangers"
  description="Ateliers de boulangerie artisanale à Suresnes. Apprenez à faire vos pains, brioches et viennoiseries au levain. Cours pour tous niveaux, demi-journées ou journées complètes."
  canonical="/ateliers"
>
  <SEO
    page="ateliers"
    breadcrumbs={[
      { name: 'Accueil', url: '/' },
      { name: 'Ateliers', url: '/ateliers' },
    ]}
  />
  <AteliersPage
    client:load
    title={title}
    subtitle={subtitle}
    intro={intro}
    workshops={workshops}
    formats={formats}
    contactPhone={contactPhone}
    contactEmail={contactEmail}
    outro={outro}
  />
</Layout>
