---
import Layout from '../layouts/Layout.astro';
import AteliersPage from '../components/react/Ateliers';
import { getEntry } from 'astro:content';

export const prerender = true;

const page = await getEntry('pages', 'ateliers');
const { title, subtitle, intro, workshops, formats, contactPhone, contactEmail, outro } = page?.data || {};
---

<Layout>
  <AteliersPage
    client:load
    title={title}
    subtitle={subtitle}
    intro={intro}
    workshops={workshops}
    formats={formats}
    contactPhone={contactPhone}
    contactEmail={contactEmail}
    outro={outro}
  />
</Layout>
