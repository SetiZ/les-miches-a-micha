---
import ProductDetailPage from '../../components/react/ProductPage';
import SEO from '../../components/SEO.astro';
import Layout from '../../layouts/Layout.astro';

export const prerender = true;

export async function getStaticPaths() {
  const { default: carte } = await import('../../data/carte.json');
  const paths = carte.products
    .filter((p: { visible: boolean }) => p.visible)
    .map((p: { id: number }) => ({
      params: { id: String(p.id) },
    }));
  return paths;
}

const { id } = Astro.params;
const { default: carte } = await import('../../data/carte.json');
const product = carte.products.find((p: { id: number }) => p.id === Number(id));
---

<Layout
  title={product?.title || 'Produit'}
  description={product?.description || `Découvrez le ${product?.title || 'produit'} de Les Miches à Micha, boulangerie artisanale bio à Suresnes.`}
  canonical={`/carte/${id}`}
  ogType="product"
  ogImage={`/og/carte/${id}.jpeg`}
>
  <SEO
    page="product"
    productName={product?.title}
    productDescription={product?.description}
    productPrice={product?.prix}
    productImage={product?.images ? `/images/${product.images}` : undefined}
    breadcrumbs={[
      { name: 'Accueil', url: '/' },
      { name: 'La Carte', url: '/carte' },
      { name: product?.title || 'Produit', url: `/carte/${id}` },
    ]}
  />
  <ProductDetailPage client:load id={Number(id)} />
</Layout>
